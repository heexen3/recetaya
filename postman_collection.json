				{
					"name": "1.3 Login (Guarda Token Automáticamente)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set(\"jwtToken\", jsonData.token);",
									"    console.log(\"Token guardado en colección:\", jsonData.token);",
									"}"
								],
